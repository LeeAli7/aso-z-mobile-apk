{
  "expo": {
    "name": "Aso-z",
    "slug": "aso-z-mobile",
    "version": "1.5.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#050505",
      "image": "./assets/logo.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "app.aso.zmobile",
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./modules/aso-runtime/app.plugin.js",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/MiSansLatin-Regular.otf",
            "./assets/fonts/MiSansLatin-Medium.otf",
            "./assets/fonts/MiSansLatin-Demibold.otf",
            "./assets/fonts/GeistMono-Regular.ttf",
            "./assets/fonts/GeistMono-Italic.ttf",
            "./assets/fonts/PixelifySans-Regular.ttf"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aso запрашивает доступ к фото для анализа изображений"
        }
      ]
    ]
  }
}